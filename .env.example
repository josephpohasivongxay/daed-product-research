# Required. Tavily is the sole search/discovery provider — without this
# set (and valid), search fails outright with a clear "can't connect"
# error rather than silently falling back to fake sample data.
# Free tier available. https://tavily.com
TAVILY_API_KEY=

# Optional. Powers the Facebook/Meta ads section on each store's detail
# page (active ad count, how long ads have been running, creative
# snapshots). Free API, but requires personally verifying your identity
# with Meta first (government ID upload, 1-3 business day review) before
# an access token will work — not just a signup step. Without this set,
# the detail page shows a manual "check Ad Library yourself" link instead.
# https://www.facebook.com/ads/library/api
META_ACCESS_TOKEN=
