# Recommended: without at least one of these, live discovery depends on
# scraping DuckDuckGo, which shared serverless IPs (like Vercel's) can get
# rate-limited or blocked on — the app silently falls back to sample data
# when that happens. Setting either key below makes search reliably live.

# Google Programmable Search (Custom Search JSON API) — free up to 100
# queries/day. https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# Brave Search API — free tier available (signup required).
# https://brave.com/search/api/
BRAVE_API_KEY=
